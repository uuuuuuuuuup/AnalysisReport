<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>投资账本 · 金融终端</title>
<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap');

  :root {
    --bg-root: #0d0d0d; --bg-card: #18181b; --border: #252528;
    --text-1: #e4e4e7; --text-2: #909099; --text-3: #52525b;
    --up: #ef4444; --down: #22c55e; --orange: #f97316; --radius: 12px;
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    font-family: 'Noto Sans SC', -apple-system, sans-serif;
    background: var(--bg-root); color: var(--text-1); min-height: 100vh;
  }
  body::before {
    content: ''; position: fixed; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 48px 48px; pointer-events: none; z-index: 0;
  }

  .top-bar {
    position: sticky; top: 0; z-index: 100;
    background: #0d0d0dee; backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border); padding: 0 20px; height: 44px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .breadcrumb { font-size: 12px; color: var(--text-2); display: flex; align-items: center; gap: 8px; }
  .breadcrumb span { color: var(--text-1); }
  .top-actions { display: flex; align-items: center; gap: 12px; font-size: 11px; color: var(--text-2); }
  .live-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--up); animation: pulse 2s infinite; display: inline-block; margin-right: 4px; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

  .dashboard {
    position: relative; z-index: 1; padding: 12px;
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    gap: 12px; max-width: 1600px; margin: 0 auto;
  }
  .card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 14px;
    overflow: hidden; display: flex; flex-direction: column;
  }
  .card-title {
    font-size: 11px; font-weight: 600; color: var(--text-2);
    letter-spacing: 0.5px; margin-bottom: 8px;
    display: flex; align-items: center; gap: 6px;
  }
  .card-title::before { content: ''; width: 6px; height: 6px; background: var(--orange); flex-shrink: 0; }
  .col-1 { grid-column: span 1; } .col-2 { grid-column: span 2; }
  .row-2 { grid-row: span 2; min-height: 320px; }

  /* Eye toggle */
  .eye-btn {
    background: none; border: 1px solid var(--border); border-radius: 4px;
    color: var(--text-3); cursor: pointer; font-size: 11px; padding: 2px 6px;
    font-family: inherit; margin-left: 8px;
  }
  .eye-btn:hover { color: var(--text-1); border-color: var(--text-3); }
  .masked { filter: blur(6px); transition: filter 0.2s; user-select: none; }

  /* Privacy mode: blur all monetary content */
  body.privacy .acct-card-val,
  body.privacy .acct-card-sub,
  body.privacy .acct-stat-val,
  body.privacy .index-big,
  body.privacy .index-change,
  body.privacy .gauge-num,
  body.privacy .gauge-label,
  body.privacy .card-value,
  body.privacy .stat-value,
  body.privacy .ohlc-row .val,
  body.privacy .pos-mini td:nth-child(4),
  body.privacy .pos-mini td:nth-child(5),
  body.privacy .pos-mini td:nth-child(6),
  body.privacy .pos-mini td:nth-child(7),
  body.privacy .pos-mini td:nth-child(8) { filter: blur(5px); user-select: none; }
  body.privacy #chart-monthly,
  body.privacy #cash-tbody td:nth-child(5),
  body.privacy #wl-tbody td:nth-child(2),
  body.privacy #wl-tbody td:nth-child(3),
  body.privacy .wl-avg { filter: blur(5px); user-select: none; }

  /* Sessions */
  .sessions-grid { display: grid; grid-template-columns: repeat(24, 1fr); gap: 2px; margin-bottom: 10px; }
  .sessions-grid .hour-block { aspect-ratio: 1; border-radius: 1px; background: #1a1a1e; }
  .sessions-grid .hour-block.asia { background: #f9731640; }
  .sessions-grid .hour-block.europe { background: #448aff40; }
  .sessions-grid .hour-block.us { background: #ef444440; }
  .sessions-grid .hour-block.overlap { background: #a855f740; }
  .session-legend { display: flex; gap: 10px; font-size: 9px; color: var(--text-3); font-family: 'JetBrains Mono', monospace; margin-bottom: 8px; }
  .session-legend .dot { width: 6px; height: 6px; border-radius: 1px; display: inline-block; margin-right: 3px; }
  .exchange-row { display: flex; justify-content: space-between; padding: 3px 0; border-bottom: 1px solid #1c1c1f; font-family: 'JetBrains Mono', monospace; font-size: 10px; }
  .exchange-row .ex-name { color: var(--text-2); }
  .exchange-row .ex-status { color: var(--text-3); }
  .exchange-row .ex-status.open { color: var(--up); }

  /* Gauge */
  .gauge-wrap { display: flex; align-items: center; gap: 10px; flex: 1; }
  .gauge-chart { flex: 1; min-height: 0; }
  .gauge-num { font-family: 'JetBrains Mono', monospace; font-size: 42px; font-weight: 700; color: var(--orange); letter-spacing: 4px; min-width: 72px; text-align: center; }
  .gauge-label { font-size: 10px; color: var(--text-2); text-align: center; margin-top: 2px; }
  .gauge-date { font-size: 9px; color: var(--text-3); text-align: center; margin-top: 4px; }
  .seg-bar { display: flex; gap: 2px; height: 4px; margin-top: 8px; }
  .seg-bar span { flex: 1; background: #333; border-radius: 1px; }
  .seg-bar span.active { background: var(--orange); }

  /* OHLC */
  .ohlc-row { display: flex; gap: 16px; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-2); margin-bottom: 6px; flex-wrap: wrap; }
  .ohlc-row .label { color: var(--text-3); }
  .ohlc-row .val { color: var(--text-1); font-weight: 600; }

  .chart-box { flex: 1; min-height: 0; width: 100%; }

  .treemap-legend { display: flex; gap: 12px; font-size: 9px; color: var(--text-3); margin-top: 4px; font-family: 'JetBrains Mono', monospace; }
  .treemap-legend .dot { width: 8px; height: 8px; border-radius: 2px; display: inline-block; margin-right: 3px; }

  .index-tabs { display: flex; gap: 4px; margin-bottom: 8px; }
  .index-tab { padding: 3px 10px; border-radius: 4px; font-size: 10px; cursor: pointer; background: #222; color: var(--text-3); border: none; font-family: inherit; }
  .index-tab.active { background: #333; color: var(--text-1); }
  .index-big { font-family: 'JetBrains Mono', monospace; font-size: 36px; font-weight: 700; margin-bottom: 2px; }
  .index-change { font-family: 'JetBrains Mono', monospace; font-size: 13px; margin-bottom: 8px; }

  .pos-mini { font-family: 'JetBrains Mono', monospace; font-size: 10px; width: 100%; border-collapse: collapse; }
  .pos-mini th { text-align: right; font-weight: 400; color: var(--text-3); padding: 2px 6px; border-bottom: 1px solid #222; }
  .pos-mini th:first-child { text-align: left; }
  .pos-mini td { text-align: right; padding: 2px 6px; color: var(--text-2); }
  .pos-mini td:first-child { text-align: left; color: var(--text-1); }
  .up { color: var(--up) !important; } .down { color: var(--down) !important; }
  .scroll-y { overflow-y: auto; flex: 1; scrollbar-width: thin; scrollbar-color: #333 transparent; }
  .acct-card-val { font-family: 'JetBrains Mono', monospace; font-size: 20px; font-weight: 700; }
  .acct-card-sub { font-size: 10px; margin-top: 2px; }
  .acct-stat-label { font-size: 9px; color: var(--text-3); }
  .acct-stat-val { font-family: 'JetBrains Mono', monospace; font-size: 12px; }

  /* Loading overlay */
  .loading-overlay {
    position: fixed; inset: 0; background: var(--bg-root); z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 16px;
    font-family: 'JetBrains Mono', monospace; color: var(--text-2);
  }
  .loading-spinner {
    width: 32px; height: 32px; border: 2px solid var(--border);
    border-top-color: var(--orange); border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .error-banner {
    background: #3b1116; border: 1px solid #5c1a22; border-radius: 8px;
    padding: 12px 16px; color: #f87171; font-size: 11px;
    margin-bottom: 12px; display: none;
  }

  /* Watchlist */
  .wl-summary { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-2); margin-bottom: 8px; }
  .wl-avg { font-size: 20px; font-weight: 700; }
  .wl-dist { display: flex; height: 4px; border-radius: 2px; overflow: hidden; margin: 4px 0 2px; background: var(--down); }
  .wl-dist .rise { background: var(--up); }

  /* Cash flow */
  .op-badge { font-size: 9px; padding: 1px 5px; border-radius: 3px; }
  .op-badge.trade { background: #f9731626; color: #f97316; }
  .op-badge.fund { background: #448aff26; color: #448aff; }

  @media (max-width: 1100px) { .dashboard { grid-template-columns: 1fr 1fr; } .col-2,.col-1 { grid-column: span 2; } }
  @media (max-width: 680px) { .dashboard { grid-template-columns: 1fr; } .col-2,.col-1 { grid-column: span 1; } }
</style>
</head>
<body>

<div class="loading-overlay" id="loading">
  <div class="loading-spinner"></div>
  <div id="loading-msg">正在加载数据...</div>
</div>

<header class="top-bar">
  <div class="breadcrumb">看板 › <span>投资账本 · 金融终端</span></div>
  <div class="top-actions">
    <button class="eye-btn" id="eye-btn" onclick="togglePrivacy()" title="隐藏/显示金额">👁</button>
    <span><span class="live-dot"></span>LIVE</span>
    <span id="clock">--</span>
    <span style="color:var(--text-3);cursor:pointer;" id="refresh-btn" onclick="refreshAll()">⟳</span>
  </div>
</header>

<div class="error-banner" id="error-banner"></div>

<main class="dashboard">

  <div class="card col-1">
    <div class="card-title">SESSIONS // 全球交易时段</div>
    <div class="sessions-grid" id="sessions-grid"></div>
    <div class="session-legend">
      <span><span class="dot" style="background:#f9731640;"></span>亚洲</span>
      <span><span class="dot" style="background:#448aff40;"></span>欧洲</span>
      <span><span class="dot" style="background:#ef444440;"></span>北美</span>
    </div>
    <div class="exchange-list" id="exchange-list"></div>
  </div>

  <div class="card col-1">
    <div class="card-title">A股市场温度 // 持仓情绪</div>
    <div class="gauge-wrap">
      <div class="gauge-chart" id="chart-gauge"></div>
      <div>
        <div class="gauge-num" id="gauge-num">--</div>
        <div class="gauge-label" id="gauge-label">--</div>
        <div class="gauge-date" id="gauge-date">--</div>
      </div>
    </div>
    <div class="seg-bar" id="seg-bar"></div>
  </div>

  <div class="card col-1">
    <div class="card-title">HEAT WALL // 持仓权重</div>
    <div style="font-size:10px;color:var(--text-3);margin-bottom:4px;">
      <span id="treemap-status">--</span>
      <span style="margin-left:8px;" id="treemap-time"></span>
    </div>
    <div class="chart-box" id="chart-treemap"></div>
    <div class="treemap-legend">
      <span><span class="dot" style="background:var(--up)"></span>涨</span>
      <span><span class="dot" style="background:var(--down)"></span>跌</span>
      <span><span class="dot" style="background:#444"></span>平</span>
      <span style="margin-left:auto;">块面积 = 市值</span>
    </div>
  </div>

  <div class="card col-2 row-2">
    <div class="card-title">
      CANDLESTICK //
      <select id="kline-symbol" onchange="switchSymbol()" style="
        background:#222;color:var(--text-1);border:1px solid var(--border);
        border-radius:4px;padding:2px 6px;font-size:11px;font-family:inherit;
        cursor:pointer;max-width:280px;
      "></select>
      <span style="font-size:10px;color:var(--text-3);">· 收盘价折线 · 60日</span>
    </div>
    <div class="ohlc-row" id="ohlc-row">加载中...</div>
    <div class="chart-box" id="chart-kline"></div>
    <div style="display:flex;justify-content:space-between;margin-top:4px;">
      <span style="font-size:9px;color:var(--text-3);font-family:'JetBrains Mono',monospace;">MA5 · MA10 · MA20</span>
      <span style="font-size:9px;color:var(--text-3);font-family:'JetBrains Mono',monospace;" id="kline-range"></span>
    </div>
  </div>

  <div class="card col-2">
    <div class="card-title">INDEX TAPE // 资产净值走势 · YEAR TO DATE</div>
    <div class="index-tabs" id="index-tabs">
      <button class="index-tab active" onclick="switchIndex('total')">全部合计</button>
      <button class="index-tab" onclick="switchIndex('宁静致远')">宁静致远</button>
      <button class="index-tab" onclick="switchIndex('淡泊明志')">淡泊明志</button>
    </div>
    <div class="index-big" id="index-value">--</div>
    <div class="index-change" id="index-change">--</div>
    <div class="chart-box" id="chart-index"></div>
    <div style="font-size:9px;color:var(--text-3);font-family:'JetBrains Mono',monospace;margin-top:4px;" id="index-range"></div>
  </div>

  <div class="card col-2">
    <div class="card-title">PORTFOLIO // 账户概览</div>
    <div id="acct-cards" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;flex:1;"></div>
  </div>

  <div class="card col-2">
    <div class="card-title">POSITIONS // 持仓明细 <span style="font-weight:400;font-size:10px;color:var(--text-3);margin-left:8px;" id="pos-count"></span></div>
    <div class="scroll-y" style="flex:1;max-height:260px;">
      <table class="pos-mini"><thead><tr>
        <th>名称</th><th>代码</th><th>持仓</th><th>成本</th><th>现价</th><th>市值</th><th>盈亏</th><th>盈亏%</th>
      </tr></thead><tbody id="pos-tbody"></tbody></table>
    </div>
  </div>

  <!-- 月度收益 -->
  <div class="card col-2">
    <div class="card-title">MONTHLY P&L // 月度收益 <span style="font-size:9px;color:var(--text-3);margin-left:auto;font-family:'JetBrains Mono',monospace;">¥/月</span></div>
    <div id="monthly-status" style="font-size:10px;color:var(--text-3);margin-bottom:4px;font-family:'JetBrains Mono',monospace;"></div>
    <div class="index-tabs" id="monthly-tabs"></div>
    <div class="chart-box" id="chart-monthly" style="height:180px;"></div>
  </div>

  <!-- 自选行情 -->
  <div class="card col-1 row-2" style="min-height:480px;">
    <div class="card-title">
      WATCHLIST // 自选行情
      <select id="wl-sort" onchange="renderWatchlist()" style="
        background:#222;color:var(--text-1);border:1px solid var(--border);
        border-radius:4px;padding:2px 6px;font-size:11px;font-family:inherit;
        cursor:pointer;margin-left:auto;">
        <option value="rate">涨跌幅↓</option>
        <option value="add">自选顺序</option>
        <option value="code">代码</option>
      </select>
    </div>
    <div class="wl-summary" id="wl-summary">加载中...</div>
    <div class="scroll-y" style="flex:1;">
      <table class="pos-mini"><thead><tr>
        <th>名称</th><th>现价</th><th>涨跌幅</th>
      </tr></thead><tbody id="wl-tbody"></tbody></table>
    </div>
  </div>

  <!-- 资金流水 -->
  <div class="card col-2">
    <div class="card-title">CASH FLOW // 资金流水 <span style="font-size:10px;color:var(--text-3);font-weight:400;margin-left:8px;" id="cash-range"></span></div>
    <div class="index-tabs" id="cash-tabs"></div>
    <div class="scroll-y" style="flex:1;max-height:220px;">
      <table class="pos-mini"><thead><tr>
        <th>日期</th><th>名称</th><th>操作</th><th>数量</th><th>金额</th><th>备注</th>
      </tr></thead><tbody id="cash-tbody"></tbody></table>
    </div>
    <div style="text-align:center;margin-top:8px;"><button id="cash-more" class="index-tab" onclick="loadMoreCash()" style="display:none;">加载更多</button></div>
  </div>

</main>

<script>
// ========================= LIVE DATA ENGINE =========================
const API = '/api';
let UID = '';
let store = { accounts: [], trends: {} };

async function apiFetch(path) {
  const url = API + path + (path.includes('?') ? '&' : '?') +
    `terminal=1&version=0.0.0&userid=${UID}`;
  const r = await fetch(url, { method: 'POST' });
  return r.json();
}

function showError(msg) {
  const el = document.getElementById('error-banner');
  el.textContent = '⚠ ' + msg;
  el.style.display = 'block';
}

async function loadAllData() {
  document.getElementById('loading').style.display = 'flex';
  document.getElementById('loading-msg').textContent = '正在连接...';

  try {
    // Check cookie / get userid
    const check = await fetch('/api-check').then(r => r.json());
    if (!check.has_cookie) {
      showError('未找到 Cookie 文件 (~/.tzzb_cookies)。请在浏览器登录同花顺投资账本后，从开发者工具复制 Cookie 到该文件。');
      document.getElementById('loading').style.display = 'none';
      return false;
    }
    // Extract UID from cookie on server side
    UID = check.userid || '520687019';

    document.getElementById('loading-msg').textContent = '获取账户列表...';

    // 1. Account list
    const alResp = await apiFetch('/caishen_fund/pc/account/v1/account_list');
    if (alResp.error_code !== '0') throw new Error('账户列表: ' + alResp.error_msg);
    const accountList = alResp.ex_data?.common || [];

    // 2. For each account: positions + trends
    store.accounts = [];
    store.trends = {};

    for (const acc of accountList) {
      const name = acc.manualname || '未知';
      const mid = acc.manualid || '';
      const fk = acc.fund_key || '';
      document.getElementById('loading-msg').textContent = `获取 ${name} 持仓...`;

      const extraParams = `?manual_id=${mid}&fund_key=${fk}&rzrq_fund_key=&is_merge=1`;

      // Fetch position and trend in parallel
      const [posResp, trendResp] = await Promise.all([
        apiFetch('/caishen_fund/pc/asset/v1/stock_position' + extraParams),
        apiFetch('/caishen_fund/pc/asset/v1/asset_trend' + extraParams + '&fundid=&custid=')
          .catch(() => null) // trend may fail, not critical
      ]);

      const ex = posResp.ex_data || {};
      const acctData = {
        name,
        fund_key: fk,
        manual_id: mid,
        total_asset: parseFloat(ex.total_asset || 0),
        total_value: parseFloat(ex.total_value || 0),
        money_remain: parseFloat(ex.money_remain || 0),
        position_rate: parseFloat(ex.position_rate || 0),
        upload_time: ex.upload_time || '',
        positions: (ex.position || []).map(p => ({
          code: p.code || '', name: p.name || '', market: p.market || '2',
          count: parseInt(p.count) || 0,
          cost: parseFloat(p.cost || 0),
          price: parseFloat(p.price || 0),
          value: parseFloat(p.value || 0),
          profit: parseFloat(p.hold_profit || 0),
          profit_rate: parseFloat(p.hold_rate || 0),
        }))
      };
      store.accounts.push(acctData);

      if (trendResp && trendResp.ex_data) {
        store.trends[name] = {
          year_profit: trendResp.ex_data.year_profit || [],
          month_profit: trendResp.ex_data.month_profit || [],
          total_asset: trendResp.ex_data.total_asset || [],
        };
      }
    }

    document.getElementById('loading').style.display = 'none';
    return true;
  } catch (e) {
    showError('数据加载失败: ' + e.message);
    document.getElementById('loading').style.display = 'none';
    return false;
  }
}

// ========================= HELPERS =========================
const upColor = '#ef4444', downColor = '#22c55e';
function fmtM(n) {
  if (n == null || isNaN(n)) return '--';
  const abs = Math.abs(n);
  return abs >= 1e8 ? (n/1e8).toFixed(2)+'亿'
       : abs >= 1e4 ? (n/1e4).toFixed(2)+'万'
       : n.toLocaleString('zh-CN', {minimumFractionDigits:2,maximumFractionDigits:2});
}
function fmtPct(n) { return (n>=0?'+':'')+(n*100).toFixed(2)+'%'; }
function upDown(n) { return n>0?'up':n<0?'down':''; }
function allPositions() {
  const all = [];
  store.accounts.forEach(a => a.positions.forEach(p => all.push({...p, account:a.name})));
  return all;
}

// ========================= SESSIONS =========================
function buildSessions() {
  const grid = document.getElementById('sessions-grid');
  let html = '';
  for (let h = 0; h < 24; h++) {
    let cls = '';
    if (h >= 9 && h <= 16) cls = 'asia';
    if (h >= 15 && h <= 23) cls = h <= 16 ? 'overlap' : 'europe';
    if (h >= 21 || h <= 4) cls = cls === 'overlap' || h <= 4 ? 'overlap' : 'us';
    html += `<div class="hour-block ${cls}" title="${h}:00 CST"></div>`;
  }
  grid.innerHTML = html;

  const now = new Date();
  const cstMin = now.getHours() * 60 + now.getMinutes();
  const asiaOpen = cstMin >= 9*60+30 && cstMin < 15*60;
  document.getElementById('exchange-list').innerHTML = `
    <div class="exchange-row"><span class="ex-name">SSE 上海</span><span class="ex-status ${asiaOpen?'open':''}">${asiaOpen?'● TRADING':'CLOSED'}</span></div>
    <div class="exchange-row"><span class="ex-name">SZSE 深圳</span><span class="ex-status ${asiaOpen?'open':''}">${asiaOpen?'● TRADING':'CLOSED'}</span></div>
    <div class="exchange-row"><span class="ex-name">HKEX 香港</span><span class="ex-status ${asiaOpen?'open':''}">${asiaOpen?'● TRADING':'CLOSED'}</span></div>
  `;
}

// ========================= GAUGE =========================
function initGauge() {
  const chart = echarts.init(document.getElementById('chart-gauge'), 'dark');
  let totalVal = 0, totalAsset = 0;
  store.accounts.forEach(a => { totalVal += a.total_value; totalAsset += a.total_asset; });
  const rate = totalAsset > 0 ? totalVal / totalAsset * 100 : 0;
  const score = Math.round(rate * 0.7 + 5);

  document.getElementById('gauge-num').textContent = score;
  document.getElementById('gauge-label').textContent = rate > 90 ? '重仓' : rate > 60 ? '适中' : '轻仓';
  document.getElementById('gauge-date').textContent = new Date().toISOString().slice(0,10);
  document.getElementById('seg-bar').innerHTML =
    Array.from({length:5},(_,i)=>`<span class="${i===4?'active':''}"></span>`).join('');

  chart.setOption({
    backgroundColor:'transparent',
    series:[{type:'gauge',startAngle:210,endAngle:-30,center:['50%','58%'],radius:'80%',min:0,max:100,splitNumber:10,
      axisLine:{lineStyle:{width:14,color:[[0.25,'#444'],[0.5,'#666'],[0.75,'#f97316'],[1,'#ef4444']]}},
      pointer:{length:'65%',width:4,itemStyle:{color:'#e4e4e7'}},
      axisTick:{distance:-14,length:5,lineStyle:{width:1,color:'#555'}},
      splitLine:{distance:-18,length:12,lineStyle:{width:1.5,color:'#555'}},
      axisLabel:{color:'#666',fontSize:9,distance:25,fontFamily:'JetBrains Mono'},
      anchor:{show:true,size:12,itemStyle:{borderWidth:2,borderColor:'#e4e4e7'}},
      title:{show:false},detail:{show:false},data:[{value:score}]}]
  });
  new ResizeObserver(() => chart.resize()).observe(document.getElementById('chart-gauge'));
}

// ========================= TREEMAP =========================
function initTreemap() {
  const chart = echarts.init(document.getElementById('chart-treemap'), 'dark');
  document.getElementById('treemap-time').textContent = new Date().toLocaleTimeString('zh-CN',{hour12:false});

  // Show upload time status
  const uploadTimes = store.accounts.map(a => a.upload_time ? new Date(parseInt(a.upload_time)) : null).filter(Boolean);
  const latest = uploadTimes.length ? new Date(Math.max(...uploadTimes.map(d => d.getTime()))) : null;
  document.getElementById('treemap-status').textContent = latest
    ? '数据: ' + latest.toLocaleTimeString('zh-CN',{hour12:false})
    : '--';

  const all = allPositions().filter(p => Math.abs(p.value) > 0);
  const data = all.map(p => ({
    name:p.name, value:Math.abs(p.value), profit_rate:p.profit_rate, profit:p.profit, code:p.code, account:p.account,
    itemStyle:{color:p.profit_rate>0.005?upColor+'cc':p.profit_rate>0?upColor+'88':p.profit_rate>-0.005?'#444':p.profit_rate>-0.02?downColor+'88':downColor+'cc'}
  }));

  chart.setOption({
    backgroundColor:'transparent',
    tooltip:{backgroundColor:'#1a1a1f',borderColor:'#333',textStyle:{fontSize:11,fontFamily:'JetBrains Mono'},
      formatter:p=>{const d=p.data;if(!d?.profit_rate&&d?.profit_rate!==0)return p.name;
        return `<b>${d.name}</b> ${d.code}<br/>市值:¥${fmtM(d.value)}<br/>涨跌:<span style="color:${d.profit_rate>=0?upColor:downColor}">${fmtPct(d.profit_rate)}</span><br/>账户:${d.account}`;}},
    series:[{type:'treemap',data,roam:false,nodeClick:false,breadcrumb:{show:false},
      label:{show:true,formatter:p=>{const n=(p.name||'').length>4?p.name.slice(0,4)+'~':p.name;const r=p.data?.profit_rate||0;return `{name|${n}}\n{pct|${r>=0?'+':''}${(r*100).toFixed(1)}%}`;},
        rich:{name:{fontSize:9,color:'#ddd',lineHeight:15},pct:{fontSize:8,color:'#999',lineHeight:13,fontFamily:'JetBrains Mono'}}},
      upperLabel:{show:false},itemStyle:{borderColor:'#18181b',borderWidth:2,gapWidth:2}}]
  });
  new ResizeObserver(()=>chart.resize()).observe(document.getElementById('chart-treemap'));
}

// ========================= K-LINE (dynamic from Eastmoney, 前复权) =========================
const klineCache = {};
let klineChart, currentSymbol = '511010';

function buildSymbolSelector() {
  const sel = document.getElementById('kline-symbol');
  const all = allPositions().filter(p => p.value > 0);
  // Deduplicate by code
  const seen = new Set();
  const unique = all.filter(p => { if (seen.has(p.code)) return false; seen.add(p.code); return true; });

  // Group by account
  const groups = {};
  store.accounts.forEach(a => {
    const items = unique.filter(p => a.positions.some(ap => ap.code === p.code));
    if (items.length) groups[a.name] = items;
  });

  let html = '';
  for (const [acct, items] of Object.entries(groups)) {
    html += `<optgroup label="── ${acct} ──">`;
    items.forEach(p => {
      const sel = p.code === currentSymbol ? ' selected' : '';
      html += `<option value="${p.code}"${sel}>${p.code} ${p.name}</option>`;
    });
    html += '</optgroup>';
  }
  sel.innerHTML = html;
}

async function fetchKline(code) {
  if (klineCache[code]) return klineCache[code];
  // Look up market from any position
  const pos = allPositions().find(p => p.code === code);
  const market = pos?.market || '2';
  const r = await fetch(`/kline/${code}?market=${market}`);
  const data = await r.json();
  if (data.error) throw new Error(data.error);
  klineCache[code] = data;
  return data;
}

async function switchSymbol() {
  currentSymbol = document.getElementById('kline-symbol').value;
  await renderKline();
}

async function renderKline() {
  const dom = document.getElementById('chart-kline');
  if (!klineChart) klineChart = echarts.init(dom, 'dark');

  try {
    const kd = await fetchKline(currentSymbol);
    const dates = kd.dates, closes = kd.closes;

    if (!dates.length) { dom.innerHTML = '<div style="color:#666;text-align:center;padding-top:20%;">无数据</div>'; return; }

    const last = closes[closes.length-1], prev = closes[closes.length-2];
    const change = prev ? (last-prev)/prev : 0;
    document.getElementById('ohlc-row').innerHTML =
      `<span><span class="label">最新</span> <span class="val">${last.toFixed(2)}</span></span>` +
      `<span><span class="label">日涨跌</span> <span class="val" style="color:${change>=0?upColor:downColor}">${(change>=0?'+':'')+(change*100).toFixed(2)}%</span></span>`;
    document.getElementById('kline-range').textContent = dates[0]+' — '+dates[dates.length-1];

    const ma = (arr,p) => arr.map((_,i) => {
      if (i<p-1) return null; let s=0;
      for (let j=i-p+1;j<=i;j++) s+=arr[j];
      return +(s/p).toFixed(3);
    });

    klineChart.setOption({
      backgroundColor:'transparent',
      grid: {left:'7%',right:'4%',top:'4%',bottom:'2%'},
      xAxis:{type:'category',data:dates,axisLine:{lineStyle:{color:'#333'}},axisLabel:{color:'#555',fontSize:9,formatter:v=>v.slice(5)},boundaryGap:false,axisTick:{show:false},splitLine:{show:false}},
      yAxis:{type:'value',scale:true,splitNumber:5,axisLabel:{color:'#555',fontSize:9,formatter:v=>v.toFixed(2)},splitLine:{lineStyle:{color:'#1a1a22',type:'dashed'}},axisLine:{show:false},axisTick:{show:false}},
      series:[
        {name:'收盘价',type:'line',data:closes,smooth:true,lineStyle:{width:1.5,color:'#f97316'},itemStyle:{color:'#f97316'},symbol:'none',areaStyle:{color:new echarts.graphic.LinearGradient(0,0,0,1,[{offset:0,color:'rgba(249,115,22,0.15)'},{offset:1,color:'rgba(249,115,22,0)'}])}},
        {name:'MA5',type:'line',data:ma(closes,5),smooth:true,lineStyle:{width:1,color:'#e4e4e7'},symbol:'none'},
        {name:'MA10',type:'line',data:ma(closes,10),smooth:true,lineStyle:{width:1,color:'#e4e4e7',type:'dashed'},symbol:'none'},
        {name:'MA20',type:'line',data:ma(closes,20),smooth:true,lineStyle:{width:1,color:'#448aff'},symbol:'none'}
      ],
      tooltip:{trigger:'axis',backgroundColor:'#1a1a1f',borderColor:'#333',textStyle:{fontSize:11,fontFamily:'JetBrains Mono'},formatter:params=>params[0].axisValue+'<br/>'+params.map(p=>`${p.marker} ¥${p.value.toFixed(3)}`).join('<br/>')}
    });
    klineChart.resize();
  } catch(e) {
    dom.innerHTML = `<div style="color:#f87171;text-align:center;padding-top:20%;">K线加载失败: ${e.message}</div>`;
  }
}

async function initKline() {
  buildSymbolSelector();
  await renderKline();
  new ResizeObserver(() => klineChart?.resize()).observe(document.getElementById('chart-kline'));
}

// ========================= ASSET TREND =========================
let indexChart, indexMode = 'total';

function switchIndex(mode) {
  indexMode = mode;
  document.querySelectorAll('#index-tabs .index-tab').forEach(t => {
    t.classList.toggle('active',
      mode==='total' ? t.textContent.includes('全部') : t.textContent.includes(mode));
  });
  updateIndex();
}

function initIndex() {
  indexChart = echarts.init(document.getElementById('chart-index'), 'dark');
  updateIndex();
  new ResizeObserver(()=>indexChart.resize()).observe(document.getElementById('chart-index'));
}

function updateIndex() {
  let data = [];
  if (indexMode === 'total') {
    const sMap={}, hMap={};
    (store.trends['宁静致远']?.year_profit||[]).forEach(d=>{sMap[d.date]=d.asset;});
    (store.trends['淡泊明志']?.year_profit||[]).forEach(d=>{hMap[d.date]=d.asset;});
    data = [...new Set([...Object.keys(sMap),...Object.keys(hMap)])].sort()
      .map(d=>({date:d,value:(sMap[d]||0)+(hMap[d]||0)}));
  } else {
    data = (store.trends[indexMode]?.year_profit||[]).map(d=>({date:d.date,value:d.asset}));
  }
  if (!data.length) return;

  const dates = data.map(d=>d.date.slice(4,6)+'/'+d.date.slice(6));
  const values = data.map(d=>d.value);
  const last=values[values.length-1], prev=values[values.length-2], change=prev?(last-prev)/prev:0;

  document.getElementById('index-value').textContent = '¥'+fmtM(last);
  document.getElementById('index-change').innerHTML = prev
    ? `<span class="${change>=0?'up':'down'}">${fmtPct(change)}</span>` : '';
  document.getElementById('index-range').textContent =
    data[0].date.slice(0,4)+'/'+data[0].date.slice(4,6)+'/'+data[0].date.slice(6)+
    ' — '+data[data.length-1].date.slice(0,4)+'/'+data[data.length-1].date.slice(4,6)+'/'+data[data.length-1].date.slice(6);

  const color = indexMode==='total'?'#f97316':indexMode==='宁静致远'?'#448aff':'#22c55e';
  indexChart.setOption({
    backgroundColor:'transparent',grid:{left:'7%',right:'3%',top:'6%',bottom:'2%'},
    xAxis:{type:'category',data:dates,axisLabel:{color:'#555',fontSize:9,interval:Math.floor(dates.length/6)},axisLine:{lineStyle:{color:'#333'}},axisTick:{show:false}},
    yAxis:{type:'value',scale:true,axisLabel:{color:'#555',fontSize:9,formatter:v=>(v/10000).toFixed(0)+'万'},splitLine:{lineStyle:{color:'#1a1a22'}},axisLine:{show:false},axisTick:{show:false}},
    series:[{type:'line',data:values,smooth:true,lineStyle:{width:1.5,color},itemStyle:{color},symbol:'none',areaStyle:{color:new echarts.graphic.LinearGradient(0,0,0,1,[{offset:0,color:color+'20'},{offset:1,color:color+'00'}])}}],
    tooltip:{trigger:'axis',backgroundColor:'#1a1a1f',borderColor:'#333',textStyle:{fontSize:11,fontFamily:'JetBrains Mono'},formatter:params=>params[0].axisValue+'<br/>¥'+params[0].value.toLocaleString()}
  });
}

// ========================= MONTHLY P&L =========================
let monthlyChart = null, monthlyData = {}, monthlyMode = 'total';

async function loadMonthly() {
  const st = document.getElementById('monthly-status');
  st.textContent = '加载中...';
  st.style.color = 'var(--text-3)';
  try {
    const entries = await Promise.all(store.accounts.map(async a => {
      const resp = await apiFetch(`/caishen_fund/pc/asset/v1/merge_compare?manual_id=${a.manual_id}&fund_key=${a.fund_key}&rzrq_fund_key=&fund_id=&custid=`);
      return [a.name, resp.ex_data?.profit_compare || []];
    }));
    monthlyData = Object.fromEntries(entries);
    buildMonthlyTabs();
    updateMonthly();
    st.textContent = '';
  } catch (e) {
    st.textContent = '月度收益加载失败: ' + e.message;
    st.style.color = '#f87171';
    monthlyChart.clear();
  }
}

function buildMonthlyTabs() {
  document.getElementById('monthly-tabs').innerHTML =
    `<button class="index-tab" onclick="switchMonthly('total')">全部合计</button>` +
    store.accounts.map(a => `<button class="index-tab" onclick="switchMonthly('${a.name}')">${a.name}</button>`).join('');
  document.querySelectorAll('#monthly-tabs .index-tab').forEach(t =>
    t.classList.toggle('active', monthlyMode === 'total' ? t.textContent.includes('全部') : t.textContent.includes(monthlyMode)));
}

function switchMonthly(mode) {
  monthlyMode = mode;
  document.querySelectorAll('#monthly-tabs .index-tab').forEach(t =>
    t.classList.toggle('active', mode === 'total' ? t.textContent.includes('全部') : t.textContent.includes(mode)));
  updateMonthly();
}

function updateMonthly() {
  if (!monthlyChart) return;
  let months = [], values = [];
  if (monthlyMode === 'total') {
    const map = {};
    Object.values(monthlyData).forEach(arr => arr.forEach(d => { map[d.month] = (map[d.month] || 0) + d.profit; }));
    months = Object.keys(map).sort();
    values = months.map(m => map[m]);
  } else {
    const arr = monthlyData[monthlyMode] || [];
    months = arr.map(d => d.month);
    values = arr.map(d => d.profit);
  }
  if (!months.length) { monthlyChart.clear(); return; }
  monthlyChart.setOption({
    backgroundColor: 'transparent',
    grid: { left: '8%', right: '3%', top: '8%', bottom: '4%' },
    xAxis: { type: 'category', data: months, axisLabel: { color: '#555', fontSize: 9, formatter: v => v.slice(5) + '月' }, axisLine: { lineStyle: { color: '#333' } }, axisTick: { show: false } },
    yAxis: { type: 'value', axisLabel: { color: '#555', fontSize: 9, formatter: v => (v / 10000).toFixed(0) + '万' }, splitLine: { lineStyle: { color: '#1a1a22' } }, axisLine: { show: false }, axisTick: { show: false } },
    series: [{
      type: 'bar', data: values, barWidth: '55%',
      itemStyle: { color: p => p.value > 0 ? upColor : p.value < 0 ? downColor : '#3f3f46' }
    }],
    tooltip: { trigger: 'axis', backgroundColor: '#1a1a1f', borderColor: '#333', textStyle: { fontSize: 11, fontFamily: 'JetBrains Mono' },
      formatter: ps => { const p = ps[0]; const c = p.value > 0 ? upColor : p.value < 0 ? downColor : '#999';
        return p.axisValue + '<br/><span style="color:' + c + '">' + (p.value >= 0 ? '+' : '') + '¥' + p.value.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '</span>'; } }
  });
}

function initMonthly() {
  if (!monthlyChart) {
    monthlyChart = echarts.init(document.getElementById('chart-monthly'), 'dark');
    new ResizeObserver(() => monthlyChart.resize()).observe(document.getElementById('chart-monthly'));
  }
  loadMonthly();
}

// ========================= WATCHLIST =========================
let wlItems = [], wlStats = { rise: 0, fall: 0, avg: 0 };

async function loadWatchlist() {
  const tbody = document.getElementById('wl-tbody');
  tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;color:#666;">加载中...</td></tr>';
  try {
    const sl = await apiFetch('/caishen_fund/pc/optional/v1/sort_list?sort_rule=&sort_order=');
    wlItems = (sl.ex_data?.list || []).map(i => ({
      code: i.code || '', name: i.name || '', market: i.market || '',
      price: parseFloat(i.price) || 0, rate: parseFloat(i.rate) || 0, add: parseInt(i.addTime) || 0
    }));
    const codes = wlItems.filter(i => i.market && i.code).map(i => `${i.market}:${i.code}`).join(',');
    const rf = await apiFetch('/caishen_fund/pc/optional/v1/rise_fall?stock_code=' + codes + '&fund_code=');
    const d = rf.ex_data || {};
    wlStats = { rise: parseInt(d.stock_rise) || 0, fall: parseInt(d.stock_fall) || 0, avg: parseFloat(d.avg_rate) || 0 };
    renderWatchlist();
  } catch (e) {
    tbody.innerHTML = `<tr><td colspan="3" style="text-align:center;color:#f87171;">自选行情加载失败: ${e.message}</td></tr>`;
  }
}

function renderWatchlist() {
  const items = [...wlItems];
  const sort = document.getElementById('wl-sort').value;
  if (sort === 'rate') items.sort((a, b) => b.rate - a.rate);
  else if (sort === 'add') items.sort((a, b) => a.add - b.add);
  else items.sort((a, b) => a.code.localeCompare(b.code));
  const s = wlStats, total = s.rise + s.fall;
  const pct = total ? (s.rise / total * 100).toFixed(0) : 50;
  document.getElementById('wl-summary').innerHTML =
    `<span class="up">↑${s.rise}</span> <span class="down">↓${s.fall}</span>` +
    `<span style="color:var(--text-3);margin-left:6px;">平 ${wlItems.length - total}</span>` +
    `<span class="wl-avg ${s.avg > 0 ? 'up' : s.avg < 0 ? 'down' : ''}" style="margin-left:8px;">${s.avg >= 0 ? '+' : ''}${(s.avg * 100).toFixed(2)}%</span>` +
    `<div class="wl-dist"><div class="rise" style="width:${pct}%;"></div></div>`;
  document.getElementById('wl-tbody').innerHTML = items.length ? items.map(i =>
    `<tr><td title="${i.code}">${i.name}</td><td>${i.price ? i.price.toFixed(2) : '-'}</td><td class="${upDown(i.rate)}">${fmtPct(i.rate)}</td></tr>`
  ).join('') : '<tr><td colspan="3" style="text-align:center;color:#666;">自选列表为空</td></tr>';
}

function initWatchlist() { loadWatchlist(); }

// ========================= CASH FLOW =========================
let cashRows = {}, cashPage = {}, cashMax = {}, cashErr = {}, cashMode = '', cashLoadingMore = false;

function cashDates() {
  const end = new Date();
  const start = new Date(end.getTime() - 30 * 24 * 3600 * 1000);
  const f = d => `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`;
  return { start_date: f(start), end_date: f(end) };
}

async function loadCashflow() {
  if (!store.accounts.length) return;
  cashMode = store.accounts[0].name;
  buildCashTabs();
  document.getElementById('cash-tbody').innerHTML = '<tr><td colspan="6" style="text-align:center;color:#666;">加载中...</td></tr>';
  const results = await Promise.allSettled(store.accounts.map(a => fetchCashPage(a.name, 1)));
  store.accounts.forEach((a, i) => {
    cashErr[a.name] = results[i].status === 'rejected' ? (results[i].reason?.message || '加载失败') : '';
  });
  renderCashRows();
}

function buildCashTabs() {
  document.getElementById('cash-tabs').innerHTML = store.accounts.map(a =>
    `<button class="index-tab ${a.name === cashMode ? 'active' : ''}" onclick="switchCash('${a.name}')">${a.name}</button>`).join('');
  const d = cashDates();
  const f = s => s.slice(0, 4) + '-' + s.slice(4, 6) + '-' + s.slice(6);
  document.getElementById('cash-range').textContent = '近30天 ' + f(d.start_date) + ' ~ ' + f(d.end_date);
}

async function fetchCashPage(name, page) {
  const a = store.accounts.find(x => x.name === name);
  const d = cashDates();
  const resp = await apiFetch(`/caishen_fund/pc/account/v2/get_money_history?manual_id=${a.manual_id}&fund_key=${a.fund_key}&rzrq_fund_key=&fundid=&custid=&user_id=${UID}&start_date=${d.start_date}&end_date=${d.end_date}&query_list=&page=${page}&count=20&sort_type=1&sort_order=1&h5id=`);
  const ex = resp.ex_data || {};
  const list = (ex.list || []).map(r => ({
    date: r.entry_date || '', name: r.name || '', code: r.code || '',
    op: r.op_name || '', count: r.entry_count || '',
    money: parseFloat(r.entry_money) || 0, remark: r.remark || ''
  }));
  if (page === 1) { cashRows[name] = []; cashPage[name] = 1; cashMax[name] = parseInt(ex.max_page) || 1; }
  cashRows[name].push(...list);
}

function switchCash(name) {
  cashMode = name;
  document.querySelectorAll('#cash-tabs .index-tab').forEach(t => t.classList.toggle('active', t.textContent.includes(name)));
  renderCashRows();
}

function renderCashRows() {
  if (cashErr[cashMode]) {
    document.getElementById('cash-tbody').innerHTML =
      `<tr><td colspan="6" style="text-align:center;color:#f87171;">资金流水加载失败: ${cashErr[cashMode]}</td></tr>`;
    document.getElementById('cash-more').style.display = 'none';
    return;
  }
  const rows = cashRows[cashMode] || [];
  document.getElementById('cash-tbody').innerHTML = rows.length ? rows.map(r =>
    `<tr><td>${r.date}</td><td title="${r.code}">${r.name}</td>` +
    `<td><span class="op-badge ${['买入', '卖出'].includes(r.op) ? 'trade' : 'fund'}">${r.op || '--'}</span></td>` +
    `<td>${r.count}</td><td>¥${r.money.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>` +
    `<td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${r.remark || ''}</td></tr>`
  ).join('') : '<tr><td colspan="6" style="text-align:center;color:#666;">近30天无流水记录</td></tr>';
  document.getElementById('cash-more').style.display =
    (cashPage[cashMode] || 1) < (cashMax[cashMode] || 1) ? 'block' : 'none';
}

async function loadMoreCash() {
  if (cashLoadingMore) return;
  cashLoadingMore = true;
  const name = cashMode;
  cashPage[name] = (cashPage[name] || 1) + 1;
  try {
    await fetchCashPage(name, cashPage[name]);
  } catch (e) {
    cashPage[name] -= 1;
  }
  cashLoadingMore = false;
  renderCashRows();
}

function initCashflow() { loadCashflow(); }

// ========================= FILL STATS =========================
function fillAll() {
  // Account cards
  document.getElementById('acct-cards').innerHTML = store.accounts.map(a => {
    const profit = a.positions.reduce((s,p)=>s+(p.profit||0),0);
    const cls = profit>=0?'up':'down';
    return `<div>
      <div style="font-size:12px;color:var(--text-2);margin-bottom:6px;">${a.name}</div>
      <div class="acct-card-val" style="color:${a.total_asset===0?'var(--text-3)':'var(--text-1)'}">¥${fmtM(a.total_asset)}</div>
      <div class="acct-card-sub"><span class="${cls}">${profit>=0?'+':''}¥${fmtM(profit)}</span> · 仓位 ${(a.position_rate*100).toFixed(0)}%</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:6px;">
        <div><span class="acct-stat-label">市值</span><br><span class="acct-stat-val">¥${fmtM(a.total_value)}</span></div>
        <div><span class="acct-stat-label">可用</span><br><span class="acct-stat-val" style="color:#38bdf8;">¥${fmtM(a.money_remain)}</span></div>
      </div>
    </div>`;
  }).join('');

  // Position table
  const all = allPositions().sort((a,b)=>Math.abs(b.value)-Math.abs(a.value));
  document.getElementById('pos-count').textContent = `共 ${all.length} 只标的`;
  document.getElementById('pos-tbody').innerHTML = all.map(p =>
    `<tr><td>${p.name}</td><td>${p.code}</td><td>${p.count}</td><td>${p.cost?p.cost.toFixed(2):'-'}</td><td>${p.price?p.price.toFixed(2):'-'}</td><td>${fmtM(p.value)}</td><td class="${upDown(p.profit)}">${(p.profit>=0?'+':'')+fmtM(p.profit)}</td><td class="${upDown(p.profit_rate)}">${fmtPct(p.profit_rate)}</td></tr>`
  ).join('');
}

function updateClock() {
  const d = new Date();
  document.getElementById('clock').textContent =
    d.toLocaleDateString('zh-CN')+' '+d.toLocaleTimeString('zh-CN',{hour12:false})+' · CST +8';
}

async function refreshAll() {
  const ok = await loadAllData();
  if (ok) renderAll();
}

function renderAll() {
  buildSessions();
  initGauge();
  initTreemap();
  initKline();
  initIndex();
  fillAll();
  initMonthly();
  initWatchlist();
  initCashflow();
}

function togglePrivacy() {
  document.body.classList.toggle('privacy');
  const on = document.body.classList.contains('privacy');
  document.getElementById('eye-btn').textContent = on ? '👁‍🗨' : '👁';
}
document.addEventListener('DOMContentLoaded', async () => {
  updateClock();
  setInterval(updateClock, 10000);
  const ok = await loadAllData();
  if (ok) renderAll();
});
</script>
</body>
</html>
